<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Локальный репозиторий Maven (путь без кириллицы) -->
    <localRepository>C:\maven-repo\medassistant</localRepository>

    <!-- ЗЕРКАЛА для ускорения загрузки в России -->
    <mirrors>
        <!-- Alibaba Cloud Mirror (Китай - быстрее для РФ) -->
        <mirror>
            <id>aliyun-maven</id>
            <mirrorOf>central</mirrorOf>
            <name>Aliyun Maven Central</name>
            <url>https://maven.aliyun.com/repository/central</url>
        </mirror>

        <!-- Huawei Cloud Mirror (альтернатива) -->
        <mirror>
            <id>huaweicloud-maven</id>
            <mirrorOf>central</mirrorOf>
            <name>Huawei Cloud Maven Central</name>
            <url>https://mirrors.huaweicloud.com/maven/</url>
        </mirror>
    </mirrors>

    <!-- Настройки профилей -->
    <profiles>
        <profile>
            <id>medassistant</id>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
            </properties>

            <!-- Увеличенные таймауты -->
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                        <checksumPolicy>warn</checksumPolicy>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <!-- Активный профиль по умолчанию -->
    <activeProfiles>
        <activeProfile>medassistant</activeProfile>
    </activeProfiles>

</settings>