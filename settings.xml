<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Локальный репозиторий внутри проекта (без кириллицы в пути) -->
    <localRepository>${basedir}/.m2/repository</localRepository>

    <!-- Зеркала для обхода проблем с подключением к Maven Central -->
    <mirrors>
        <!-- Зеркало Aliyun (Китай) - быстрое и надёжное -->
        <mirror>
            <id>aliyun</id>
            <mirrorOf>central</mirrorOf>
            <name>Aliyun Maven Mirror</name>
            <url>https://maven.aliyun.com/repository/central</url>
        </mirror>
        
        <!-- Резервное зеркало -->
        <mirror>
            <id>repo1</id>
            <mirrorOf>central</mirrorOf>
            <name>Repo1 Maven Mirror</name>
            <url>https://repo1.maven.org/maven2/</url>
        </mirror>
    </mirrors>

</settings>
